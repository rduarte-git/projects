@page
@model LockyApp.Pages.Armarios.CreateModel

@{
    ViewData["Title"] = "Criar Armário";
}

<h1>Criar Armário</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Armario.Nome" class="form-label"></label>
        <input asp-for="Armario.Nome" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Armario.Localizacao" class="form-label"></label>
        <input asp-for="Armario.Localizacao" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Armario.Altura" class="form-label"></label>
        <input asp-for="Armario.Altura" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Armario.Largura" class="form-label"></label>
        <input asp-for="Armario.Largura" class="form-control" />
    </div>
    
    <div class="form-check mb-3">
        <input asp-for="Armario.Activo" class="form-check-input" />
        <label asp-for="Armario.Activo" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-page="./Index" class="btn btn-secondary">Voltar</a>
</form>